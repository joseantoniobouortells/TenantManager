<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TenantManager.App.MainWindow"
        x:CompileBindings="False"
        Title="Tenant Manager - Room Management">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button Content="Refresh" Command="{Binding LoadRoomsCommand}" />
            <Button Content="New Room" Command="{Binding NewRoomCommand}" />
            <Button Content="Edit" Command="{Binding EditRoomCommand}" />
            <Button Content="Deactivate" Command="{Binding DeactivateRoomCommand}" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" IsVisible="{Binding IsEditing}" Padding="8" BorderBrush="Gray" BorderThickness="1" Margin="8">
                <StackPanel Spacing="8">
                    <TextBox PlaceholderText="Room Name" Text="{Binding EditName}" />
                    <NumericUpDown PlaceholderText="Monthly Rent" Value="{Binding EditMonthlyRent}" Minimum="0" />
                    <TextBox PlaceholderText="Notes (optional)" Text="{Binding EditNotes}" AcceptsReturn="True" Height="60" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save" Command="{Binding SaveRoomCommand}" />
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ListBox Grid.Row="1" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" Margin="8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4">
                            <TextBlock Text="{Binding Name}" Width="150" />
                            <TextBlock Text="{Binding MonthlyRent, StringFormat='{}{0:F2}'}" Width="80" />
                            <TextBlock Text="{Binding IsActive}" Width="60" />
                            <TextBlock Text="{Binding Notes}" Width="200" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
