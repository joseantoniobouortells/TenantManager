<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="using:TenantManager.App.Domain"
        xmlns:vm="using:TenantManager.App.ViewModels"
        xmlns:views="using:TenantManager.App.Views"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        x:Class="TenantManager.App.MainWindow"
        x:CompileBindings="False"
        Title="Tenant Manager"
        Icon="avares://TenantManager.App/Assets/app-icon.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True">

    <Window.Styles>
        <Style Selector="TabControl">
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="Padding" Value="32" />
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16 12" />
            <Setter Property="Margin" Value="12 4 12 4" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Width" Value="200" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ActionBackgroundBrush}" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource TabSelectedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource TabSelectedBackgroundBrush}" />
        </Style>
        
        <!-- Table Styles -->
        <Style Selector="ListBox.Table">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.Table ListBoxItem">
            <Setter Property="Padding" Value="16 12" />
            <Setter Property="Margin" Value="0 0 0 8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource TableBorderBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- TOP BAR (Integrated with Window Title Bar) -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" Padding="80,16,140,16" BorderThickness="0 0 0 1" BorderBrush="{DynamicResource TableBorderBrush}" PointerPressed="TopBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- ACTIVE PROPERTY SELECTOR + NAVIGATION BREADCRUMB (Left) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Properties}" SelectedItem="{Binding SelectedProperty}" Width="200" Height="34">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <TextBlock Text="/" Foreground="{DynamicResource TableBorderBrush}" FontWeight="Medium" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentPageTitle}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN NAVIGATION -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" SelectionChanged="TabControl_SelectionChanged">
            
            <!-- DASHBOARD -->
            <TabItem Header="{DynamicResource DashboardTab}">
                <views:DashboardView />
            </TabItem>

            <!-- PROPERTIES -->
            <TabItem Header="Viviendas">
                <views:PropertiesView />
            </TabItem>

            <!-- ROOMS -->
            <TabItem Header="{DynamicResource RoomsTab}">
                <views:RoomsView />
            </TabItem>

            <!-- TENANTS -->
            <TabItem Header="{DynamicResource TenantsTab}">
                <views:TenantsView />
            </TabItem>

            <!-- CONTRACTS -->
            <TabItem Header="{DynamicResource ContractsTab}">
                <views:ContractsView />
            </TabItem>

            <!-- PAYMENTS -->
            <TabItem Header="{DynamicResource PaymentsTab}">
                <views:PaymentsView />
            </TabItem>

            <!-- EXPENSES -->
            <TabItem Header="Gastos">
                <views:ExpensesView DataContext="{Binding}" />
            </TabItem>

            <!-- SETTINGS -->
            <TabItem Header="{DynamicResource SettingsTab}">
                <views:SettingsView />
            </TabItem>
        </TabControl>

        <!-- FOOTER / VERSION INFO -->
        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="32,0,0,32" Opacity="0.5" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Source="avares://TenantManager.App/Assets/app-icon.ico" Width="16" Height="16" />
                <TextBlock Text="Tenant Manager" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,2,0,0" />
        </StackPanel>
    </Grid>
</Window>
