    <system:String x:Key="AvailableRoomsLabel">Habitaciones Disponibles</system:String>
    <system:String x:Key="NoAvailableRoomsMsg">No hay habitaciones disponibles.</system:String>
    
    <system:String x:Key="MissingContractFilesLabel">Archivos de Contrato Faltantes</system:String>
