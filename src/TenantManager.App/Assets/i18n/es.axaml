    <system:String x:Key="AppearanceDesc">Elige el tema visual de tu preferencia para la aplicación.</system:String>
    <system:String x:Key="LightModeLabel">Modo Claro</system:String>
    <system:String x:Key="DarkModeLabel">Modo Oscuro</system:String>
    <system:String x:Key="SystemDefaultLabel">Por defecto del Sistema</system:String>
    <system:String x:Key="LanguageLabel">Idioma</system:String>
    <system:String x:Key="LanguageDesc">Elige el idioma de la aplicación.</system:String>
    <system:String x:Key="InformationLabel">Información</system:String>
    <system:String x:Key="DatabasePathLabel">Ruta Base de Datos:</system:String>
