    <system:String x:Key="FromMonthLabel">Desde Mes</system:String>
    <system:String x:Key="ToYearLabel">Hasta Año</system:String>
    <system:String x:Key="ToMonthLabel">Hasta Mes</system:String>
    <system:String x:Key="GenerateButton">Generar</system:String>
</ResourceDictionary>
