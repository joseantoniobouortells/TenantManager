    <!-- Payments View -->
    <system:String x:Key="PaymentsTitle">Pagos</system:String>
    <system:String x:Key="NewPaymentButton">+ Nuevo Pago</system:String>
    <system:String x:Key="EditPaymentTitle">Editar Pago</system:String>
