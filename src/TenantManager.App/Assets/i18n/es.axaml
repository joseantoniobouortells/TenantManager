    <system:String x:Key="PaidHeader">Pagado</system:String>
    <system:String x:Key="BatchGenerateButton">+ Generar en Lote</system:String>
    <system:String x:Key="BatchGenerateTitle">Generación de Pagos en Lote</system:String>
