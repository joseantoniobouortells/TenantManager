<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TenantManager.App.ViewModels"

             xmlns:ai="using:TenantManager.Core.Services.AI"
             xmlns:cv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TenantManager.App.Views.AssistantView"
             x:DataType="vm:AssistantViewModel"
             x:CompileBindings="True">
    
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0 0 0 24">
            <TextBlock Grid.Column="0" Classes="H1" Text="{DynamicResource AssistantTitle}" Margin="0" VerticalAlignment="Center" />

            <!-- Active model badge — shown only when AI is enabled -->
            <Border Grid.Column="2"
                    IsVisible="{Binding IsAiEnabled}"
                    VerticalAlignment="Center"
                    CornerRadius="20"
                    Padding="10,5,12,5"
                    Background="{DynamicResource PrimaryBrush}"
                    Opacity="0.85">
                <Border.Effect>
                    <DropShadowEffect Color="#3B82F6"
                                      BlurRadius="12"
                                      OffsetX="0" OffsetY="2"
                                      Opacity="0.35" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="10" Foreground="White" VerticalAlignment="Center" Opacity="0.8" />
                    <TextBlock Text="{Binding ActiveModelName}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="220" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- View when AI is disabled -->
        <Border Classes="Card" IsVisible="{Binding !IsAiEnabled}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <TextBlock Text="🤖" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource AiDisabledMessage}" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400" />
            </StackPanel>
        </Border>

        <!-- View when AI is enabled -->
        <Grid IsVisible="{Binding IsAiEnabled}" RowDefinitions="*,Auto" HorizontalAlignment="Stretch">
            
            <!-- Chat History -->
            <ScrollViewer Grid.Row="0" x:Name="ChatScrollViewer" HorizontalScrollBarVisibility="Disabled">
                <Border MaxWidth="800" HorizontalAlignment="Center" Width="{Binding #ChatScrollViewer.Bounds.Width}" Padding="16,16,16,16">
                    <StackPanel>
                        <ItemsControl x:Name="ChatItemsControl" ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                                        <!-- User Bubble -->
                                        <Border DockPanel.Dock="Right" IsVisible="{Binding IsUser}" 
                                                Background="{DynamicResource PrimaryBrush}" 
                                                CornerRadius="16,16,0,16" 
                                                Padding="12,8" 
                                                MaxWidth="600" HorizontalAlignment="Right">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource UserRoleLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,4" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="White" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Assistant Bubble -->
                                        <Border DockPanel.Dock="Left" IsVisible="{Binding !IsUser}" 
                                                Background="{DynamicResource CardBackgroundBrush}" 
                                                BorderThickness="1" BorderBrush="{DynamicResource TableBorderBrush}"
                                                CornerRadius="16,16,16,0" 
                                                Padding="12,8" 
                                                MaxWidth="600" HorizontalAlignment="Left">
                                            <StackPanel TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                                    <TextBlock Grid.Column="0" Text="{DynamicResource AssistantRoleLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    
                                                    <!-- Copy Button -->
                                                    <Button Grid.Column="1" Classes="Action" Padding="4,2" CornerRadius="4" Background="Transparent"
                                                            Click="CopyButton_OnClick" ToolTip.Tip="{DynamicResource CopyResponseTooltip}" Cursor="Hand">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="📋" FontSize="12" />
                                                            <TextBlock Text="{DynamicResource CopiedLabel}" FontSize="10" Foreground="Green" IsVisible="{Binding ShowCopiedMessage}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Progress indicator (belongs to assistant side) -->
                        <DockPanel Margin="0,0,0,12" LastChildFill="False" IsVisible="{Binding IsProcessing}">
                            <Border DockPanel.Dock="Left" Background="{DynamicResource CardBackgroundBrush}" 
                                    BorderThickness="1" BorderBrush="{DynamicResource TableBorderBrush}"
                                    CornerRadius="16,16,16,0" Padding="12,8" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="20" Height="20" Classes="Circle" Theme="{DynamicResource ProgressRing}" IsVisible="False" />
                                    <ProgressBar IsIndeterminate="True" VerticalAlignment="Center" Width="40" Height="2" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource Stage_PreparingRequest}" IsVisible="{Binding CurrentProcessingStage, Converter={x:Static cv:ObjectConverters.Equal}, ConverterParameter={x:Static ai:AiProcessingStage.PreparingRequest}}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Stage_SendingToServer}" IsVisible="{Binding CurrentProcessingStage, Converter={x:Static cv:ObjectConverters.Equal}, ConverterParameter={x:Static ai:AiProcessingStage.SendingToServer}}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Stage_WaitingForModel}" IsVisible="{Binding CurrentProcessingStage, Converter={x:Static cv:ObjectConverters.Equal}, ConverterParameter={x:Static ai:AiProcessingStage.WaitingForModel}}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Stage_ParsingPlan}" IsVisible="{Binding CurrentProcessingStage, Converter={x:Static cv:ObjectConverters.Equal}, ConverterParameter={x:Static ai:AiProcessingStage.ParsingPlan}}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Stage_ValidatingPlan}" IsVisible="{Binding CurrentProcessingStage, Converter={x:Static cv:ObjectConverters.Equal}, ConverterParameter={x:Static ai:AiProcessingStage.ValidatingPlan}}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Stage_ExecutingQuery}" IsVisible="{Binding CurrentProcessingStage, Converter={x:Static cv:ObjectConverters.Equal}, ConverterParameter={x:Static ai:AiProcessingStage.ExecutingQuery}}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Stage_FormattingResponse}" IsVisible="{Binding CurrentProcessingStage, Converter={x:Static cv:ObjectConverters.Equal}, ConverterParameter={x:Static ai:AiProcessingStage.FormattingResponse}}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Input Area -->
            <Border Grid.Row="1" MaxWidth="800" HorizontalAlignment="Center" Width="{Binding $parent.Bounds.Width}" Padding="16,0,16,24">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding InputText}" PlaceholderText="{DynamicResource AskPlaceholder}" KeyDown="Input_KeyDown" VerticalContentAlignment="Center" MinHeight="48" CornerRadius="16" Margin="0 0 8 0" Padding="16,0" />
                    <!-- Send Button -->
                    <Button Grid.Column="1" Command="{Binding SendCommand}" Classes="Primary" MinHeight="48" CornerRadius="16" Padding="16,0" ToolTip.Tip="{DynamicResource SendButton}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Send PathIcon -->
                            <PathIcon Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" Width="16" Height="16" Foreground="White" />
                            <TextBlock Text="{DynamicResource SendButton}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
