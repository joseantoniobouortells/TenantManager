<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TenantManager.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="TenantManager.App.Views.DashboardView"
             x:CompileBindings="False">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0 0 0 24">
            <TextBlock Grid.Column="0" Classes="H1" Text="{DynamicResource DashboardTitle}" Margin="0" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer>
            <StackPanel Spacing="24">
                <!-- Visual Charts Grid -->
                <Grid ColumnDefinitions="1.2*,1.5*,1*" Margin="0">
                    <!-- Card 1: Room Occupancy -->
                    <Border Classes="Card" Grid.Column="0" Margin="0 0 16 0" Height="220">
                        <DockPanel>
                            <TextBlock Text="{DynamicResource RoomOccupancyLabel}" Classes="H2" DockPanel.Dock="Top" Margin="0 0 0 16" />
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- Progress Ring -->
                                <Grid Grid.Column="0" Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 16 0">
                                    <Arc Stroke="{DynamicResource TableBorderBrush}" StrokeThickness="10" Width="90" Height="90" StartAngle="0" SweepAngle="360" />
                                    <Arc Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="10" Width="90" Height="90" StartAngle="-90" SweepAngle="{Binding Dashboard.OccupancySweepAngle}" StrokeLineCap="Round" />
                                    <TextBlock Text="{Binding Dashboard.OccupancyPercentageString}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <!-- Stats Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{DynamicResource TotalRoomsLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding Dashboard.TotalRooms}" FontWeight="Bold" Margin="8 0 0 0" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource OccupiedText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding Dashboard.OccupiedRoomsCount}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="8 0 0 0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource AvailableText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding Dashboard.AvailableRoomsCount}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="8 0 0 0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Card 2: Payment Distribution (Total Donut) -->
                    <Border Classes="Card" Grid.Column="1" Margin="0 0 16 0" Height="220">
                        <DockPanel>
                            <TextBlock Text="{DynamicResource PaymentStatusLabel}" Classes="H2" DockPanel.Dock="Top" Margin="0 0 0 12" />
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- Donut Chart -->
                                <Grid Grid.Column="0" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 12 0">
                                    <Arc Stroke="{DynamicResource TableBorderBrush}" StrokeThickness="12" Width="100" Height="100" StartAngle="0" SweepAngle="360" />
                                    <Arc Stroke="{DynamicResource SuccessBrush}" StrokeThickness="12" Width="100" Height="100"
                                         StartAngle="{Binding Dashboard.PaidStartAngle}" SweepAngle="{Binding Dashboard.PaidSweepAngle}" StrokeLineCap="Round" />
                                    <Arc Stroke="#FF9800" StrokeThickness="12" Width="100" Height="100"
                                         StartAngle="{Binding Dashboard.PartialStartAngle}" SweepAngle="{Binding Dashboard.PartialSweepAngle}" StrokeLineCap="Round" />
                                    <Arc Stroke="#2196F3" StrokeThickness="12" Width="100" Height="100"
                                         StartAngle="{Binding Dashboard.PendingStartAngle}" SweepAngle="{Binding Dashboard.PendingSweepAngle}" StrokeLineCap="Round" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Total" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Dashboard.TotalPaymentsCount}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <!-- Legend Grid -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <!-- Paid -->
                                    <Ellipse Grid.Row="0" Grid.Column="0" Fill="{DynamicResource SuccessBrush}" Width="8" Height="8" Margin="0 2 6 2" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource PaidStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 2" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Dashboard.PaidPaymentsCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0 2" VerticalAlignment="Center" />

                                    <!-- Pending -->
                                    <Ellipse Grid.Row="1" Grid.Column="0" Fill="#2196F3" Width="8" Height="8" Margin="0 2 6 2" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource PendingStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 2" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Dashboard.PendingPaymentsCount}" FontSize="11" FontWeight="Bold" Margin="0 2" VerticalAlignment="Center" />

                                    <!-- Partial -->
                                    <Ellipse Grid.Row="2" Grid.Column="0" Fill="#FF9800" Width="8" Height="8" Margin="0 2 6 2" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource PartialStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 2" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Dashboard.PartialPaymentsCount}" FontSize="11" FontWeight="Bold" Margin="0 2" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Card 3: Estimated Next Month Income -->
                    <Border Classes="Card" Grid.Column="2" Margin="16 0 0 0" Height="220">
                        <DockPanel>
                            <TextBlock Text="Ingresos Previstos" Classes="H2" DockPanel.Dock="Top" Margin="0 0 0 16" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Próximo Mes" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0 0 0 8"/>
                                <TextBlock Text="{Binding Dashboard.EstimatedNextMonthIncome, StringFormat='{}{0:C}'}" FontWeight="Bold" FontSize="28" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Lists & Charts Grid -->
                <Grid ColumnDefinitions="2*,*">
                    <!-- Column 0: Monthly Income vs Expenses Bar Chart -->
                    <Border Classes="Card" Grid.Column="0" Margin="0 0 16 0" MinHeight="360">
                        <DockPanel>
                            <!-- Header Area with selector -->
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0 0 0 16">
                                <TextBlock Grid.Column="0" Classes="H2" Text="Ingresos y Gastos" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Intervalo:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding Dashboard.AvailableIntervals}" SelectedItem="{Binding Dashboard.SelectedInterval}" Width="150">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Aggregates / Summary -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource PeriodEditBackgroundBrush}" Padding="16 12" CornerRadius="8" Margin="0 0 0 24">
                                <Grid ColumnDefinitions="*,*,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Total Ingresado" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                        <TextBlock Text="{Binding Dashboard.TotalPeriodIncome, StringFormat='{}{0:C0}'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Total Gastado" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                        <TextBlock Text="{Binding Dashboard.TotalPeriodExpenses, StringFormat='{}{0:C0}'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Beneficio Neto" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                        <TextBlock Text="{Binding Dashboard.PeriodProfit, StringFormat='{}{0:C0}'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bar Chart -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0 0 0 16">
                                <ItemsControl ItemsSource="{Binding Dashboard.MonthlyBarChartItems}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="200" Spacing="24" Margin="16 0 16 0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="8">
                                                <!-- Bars Container -->
                                                <Grid ColumnDefinitions="Auto,Auto" Height="160" VerticalAlignment="Bottom">
                                                    <!-- Income Bar -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding IncomeString}" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" Margin="0 0 0 4" FontWeight="Medium"/>
                                                        <Border Width="24" Height="{Binding IncomeHeight}" Background="{DynamicResource SuccessBrush}" CornerRadius="4 4 0 0" ToolTip.Tip="{Binding IncomeString}" />
                                                    </StackPanel>
                                                    <!-- Expense Bar -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="4 0 0 0">
                                                        <TextBlock Text="{Binding ExpenseString}" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource DangerBrush}" Margin="0 0 0 4" FontWeight="Medium"/>
                                                        <Border Width="24" Height="{Binding ExpenseHeight}" Background="{DynamicResource DangerBrush}" CornerRadius="4 4 0 0" ToolTip.Tip="{Binding ExpenseString}" />
                                                    </StackPanel>
                                                </Grid>
                                                <!-- Month Label -->
                                                <TextBlock Text="{Binding MonthName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" FontWeight="Medium" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Column 1: Pending Payments -->
                    <Border Classes="Card" Grid.Column="1" Margin="0" MinHeight="360">
                        <DockPanel>
                            <TextBlock Classes="H2" Text="Cuotas Pendientes" DockPanel.Dock="Top" Margin="0 0 0 16" />
                            <TextBlock Text="✅ Sin cuotas pendientes" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding Dashboard.HasNoPendingPayments}" VerticalAlignment="Center" HorizontalAlignment="Center" DockPanel.Dock="Top" Margin="0 80 0 0"/>

                            <ListBox Classes="Table" ItemsSource="{Binding Dashboard.PendingPayments}" IsVisible="{Binding !Dashboard.HasNoPendingPayments}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0 4">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TenantName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MonthLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource DangerBrush}" CornerRadius="4" Padding="6 2" Margin="8 0" VerticalAlignment="Center"
                                                    IsVisible="{Binding IsOverdue}">
                                                <TextBlock Text="Atrasado" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalExpected, StringFormat='{}{0:C}'}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
