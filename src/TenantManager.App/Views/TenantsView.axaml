<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TenantManager.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TenantManager.App.Views.TenantsView"
             x:CompileBindings="False">
    <Grid>
        <DockPanel IsEnabled="{Binding !TenantList.IsConfirmingDeleteTenant}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0 0 0 24">
            <TextBlock Grid.Column="0" Classes="H1" Text="{DynamicResource TenantsTitle}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <TextBox Text="{Binding TenantList.SearchQuery}" PlaceholderText="{DynamicResource SearchTenantPlaceholder}" Width="200" VerticalAlignment="Center" />
                <Button Content="{DynamicResource NewTenantButton}" Command="{Binding TenantList.NewTenantCommand}" Classes="Primary" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Classes="Card" IsVisible="{Binding TenantList.IsEditing}">
            <StackPanel Spacing="16">
                <TextBlock Classes="H2" Text="{DynamicResource EditTenantTitle}" Margin="0" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0 0 0 0">
                    <!-- Col 1 -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0 0 8 12">
                        <TextBlock Text="{DynamicResource FullNameLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding TenantList.EditFullName}" />
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0 0 8 12">
                        <TextBlock Text="{DynamicResource PhoneOptionalLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding TenantList.EditPhone}" />
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="2" Margin="0 0 8 12">
                        <TextBlock Text="{DynamicResource EmailOptionalLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding TenantList.EditEmail}" />
                    </StackPanel>

                </Grid>
                <StackPanel>
                    <TextBlock Text="{DynamicResource NotesOptionalLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                    <TextBox Text="{Binding TenantList.EditNotes}" AcceptsReturn="True" Height="60" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource CancelButton}" Command="{Binding TenantList.CancelEditCommand}" Classes="Action" />
                    <Button Content="{DynamicResource SaveTenantButton}" Command="{Binding TenantList.SaveTenantCommand}" Classes="Primary" />
                </StackPanel>
            </StackPanel>
        </Border>


        <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,1.5*,Auto" Margin="16 0 16 8">
            <Button Grid.Column="0" Command="{Binding TenantList.SortCommand}" CommandParameter="Name" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{DynamicResource NameHeader}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding TenantList.NameSortIndicator}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{Binding TenantList.SortCommand}" CommandParameter="Phone" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{DynamicResource PhoneHeader}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding TenantList.PhoneSortIndicator}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="2" Text="" Width="40" />
        </Grid>

        <ListBox Classes="Table" ItemsSource="{Binding TenantList.Tenants}" SelectedItem="{Binding TenantList.SelectedTenant}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="2*,1.5*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding FullName}" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Phone}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" 
                                Command="{Binding $parent[UserControl].DataContext.TenantList.DeleteTenantCommand}" 
                                CommandParameter="{Binding}"
                                Classes="Action" Padding="4" Margin="4 0 0 0" ToolTip.Tip="{DynamicResource DeleteButton}" Cursor="Hand">
                            <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </DockPanel>

        <!-- Confirmation Overlay -->
        <Border Background="#A0000000" IsVisible="{Binding TenantList.IsConfirmingDeleteTenant}">
            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="320"
                    Height="160"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20">
                <StackPanel Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource ConfirmDeleteTitle}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource CannotUndoMsg}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Content="{DynamicResource ConfirmButton}" Command="{Binding TenantList.ConfirmDeleteTenantCommand}" Classes="Primary" Background="{DynamicResource DangerBrush}" />
                        <Button Content="{DynamicResource CancelButton}" Command="{Binding TenantList.CancelDeleteTenantCommand}" Classes="Action" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
