<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TenantManager.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TenantManager.App.Views.ContractsView"
             x:CompileBindings="False">
    <Grid>
        <DockPanel IsEnabled="{Binding !ContractList.IsConfirmingDeleteContract}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0 0 0 24">
            <TextBlock Grid.Column="0" Classes="H1" Text="{DynamicResource ContractsTitle}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <TextBox Text="{Binding ContractList.SearchQuery}" PlaceholderText="Buscar contrato..." Width="200" VerticalAlignment="Center" />
                <Button Content="{DynamicResource NewContractButton}" Command="{Binding ContractList.NewContractCommand}" Classes="Primary" />
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*, Auto">
            <!-- Left Side: Contracts List & Editing -->
            <DockPanel Grid.Column="0" Margin="0">
                <!-- Editing Card -->
                <Border Classes="Card" IsVisible="{Binding ContractList.IsEditing}">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="H2" Text="{DynamicResource EditContractTitle}" Margin="0" />
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Margin="0 0 8 0">
                                <TextBlock Text="{DynamicResource SelectTenantLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <ComboBox ItemsSource="{Binding ContractList.AvailableTenants}" SelectedItem="{Binding ContractList.EditSelectedTenant}" DisplayMemberBinding="{Binding FullName}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8 0 0 0">
                                <TextBlock Text="Habitación" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <ComboBox ItemsSource="{Binding ContractList.AvailableRooms}" SelectedItem="{Binding ContractList.EditSelectedRoom}" DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource FilePathLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding ContractList.EditFilePath}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="..." Click="BrowseFile_Click" Margin="8 0 0 0" Classes="Action" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource StartDateLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4" />
                                <DatePicker SelectedDate="{Binding ContractList.EditStartDate}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource EndDateLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4" />
                                <DatePicker SelectedDate="{Binding ContractList.EditEndDate}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel>
                                <TextBlock Text="Cuota de Alquiler" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <NumericUpDown Value="{Binding ContractList.EditMonthlyRent}" Minimum="0" FormatString="0.00" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Fianza" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <NumericUpDown Value="{Binding ContractList.EditDepositAmount}" Minimum="0" FormatString="0.00" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Día de Pago" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <NumericUpDown Value="{Binding ContractList.EditPaymentDay}" Minimum="1" Maximum="31" FormatString="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Tipo de Gastos" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <ComboBox ItemsSource="{Binding ContractList.AvailableExpenseTypes}" SelectedItem="{Binding ContractList.EditExpensePaymentType}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding ContractList.EditExpensePaymentType, Converter={StaticResource EqualityConverter}, ConverterParameter=Fixed}">
                                <TextBlock Text="Gastos Fijos" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <NumericUpDown Value="{Binding ContractList.EditFixedExpenseAmount}" Minimum="0" FormatString="0.00" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource NotesOptionalLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding ContractList.EditNotes}" AcceptsReturn="True" Height="60" />
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ContractList.HasSelectedContract}">
                                <Button Content="{DynamicResource OpenFileButton}" Command="{Binding ContractList.OpenFileCommand}" Classes="Action" />
                                <Button Content="{DynamicResource DeleteButton}" Command="{Binding ContractList.DeleteContractCommand}" Classes="Action" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource CancelButton}" Command="{Binding ContractList.CancelEditCommand}" Classes="Action" />
                                <Button Content="{DynamicResource SaveContractButton}" Command="{Binding ContractList.SaveContractCommand}" Classes="Primary" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- List/Table Container -->
                <DockPanel IsVisible="{Binding !ContractList.IsEditing}">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="1.5*,1*,1*,1*,1*,1*,Auto" Margin="16 0 16 8">
                         <Button Grid.Column="0" Command="{Binding ContractList.SortCommand}" CommandParameter="Tenant" 
                                 Background="Transparent" BorderThickness="0" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand">
                             <StackPanel Orientation="Horizontal" Spacing="4">
                                 <TextBlock Text="{DynamicResource TenantHeader}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                                 <TextBlock Text="{Binding ContractList.TenantSortIndicator}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                             </StackPanel>
                         </Button>
                         <TextBlock Grid.Column="1" Text="Habitación" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                         <TextBlock Grid.Column="2" Text="{DynamicResource FilePathHeader}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                         <TextBlock Grid.Column="3" Text="{DynamicResource FileStatusHeader}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                         <Button Grid.Column="4" Command="{Binding ContractList.SortCommand}" CommandParameter="StartDate" 
                                 Background="Transparent" BorderThickness="0" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand">
                             <StackPanel Orientation="Horizontal" Spacing="4">
                                 <TextBlock Text="{DynamicResource StartDateLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                                 <TextBlock Text="{Binding ContractList.StartDateSortIndicator}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                             </StackPanel>
                         </Button>
                         <Button Grid.Column="5" Command="{Binding ContractList.SortCommand}" CommandParameter="EndDate" 
                                 Background="Transparent" BorderThickness="0" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand">
                             <StackPanel Orientation="Horizontal" Spacing="4">
                                 <TextBlock Text="{DynamicResource EndDateLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                                 <TextBlock Text="{Binding ContractList.EndDateSortIndicator}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                             </StackPanel>
                         </Button>
                         <TextBlock Grid.Column="6" Text="" Width="40" />
                    </Grid>

                    <ListBox Classes="Table" ItemsSource="{Binding ContractList.Contracts}" SelectedItem="{Binding ContractList.SelectedItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="1.5*,1*,1*,1*,1*,1*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding TenantName}" FontWeight="Medium" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding RoomName}" FontWeight="Medium" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Contract.FilePath}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0 0 12 0" />
                                    <TextBlock Grid.Column="3" Text="{Binding FileExists, Converter={StaticResource YesNoConverter}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="{Binding StartDate, StringFormat='{}{0:d}'}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding EndDate, StringFormat='{}{0:d}'}" VerticalAlignment="Center" />
                                    <Button Grid.Column="6" 
                                            Command="{Binding $parent[UserControl].DataContext.ContractList.DeleteContractCommand}" 
                                            CommandParameter="{Binding}"
                                            Classes="Action" Padding="4" Margin="4 0 0 0" ToolTip.Tip="{DynamicResource DeleteButton}" Cursor="Hand">
                                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>

            <!-- Right Side: Extensions -->
            <Border Grid.Column="1" Classes="Card" IsVisible="{Binding ContractList.HasSelectedContract}" Width="360" Margin="16 0 0 0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="H2" Text="{DynamicResource ExtensionsTitle}" />
                     <Grid DockPanel.Dock="Top" Margin="0 0 0 16">
                        <!-- Standard Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !ContractList.IsConfirmingDeleteExtension}">
                            <Button Command="{Binding ContractList.NewExtensionCommand}" Classes="Primary" Padding="8" ToolTip.Tip="{DynamicResource NewExtensionButton}">
                                <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="16" Height="16" Foreground="White" />
                            </Button>
                            <Button Command="{Binding ContractList.EditExtensionCommand}" Classes="Action" Padding="8" ToolTip.Tip="{DynamicResource EditButton}">
                                <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Width="16" Height="16" />
                            </Button>
                            <Button Command="{Binding ContractList.DeleteExtensionCommand}" Classes="Action" Padding="8" ToolTip.Tip="{DynamicResource DeleteButton}">
                                <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}" />
                            </Button>
                            <Button Command="{Binding ContractList.OpenFileExtensionCommand}" Classes="Action" Padding="8" ToolTip.Tip="{DynamicResource OpenFileButton}">
                                <PathIcon Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" Width="16" Height="16" />
                            </Button>
                        </StackPanel>

                        <!-- Deletion Confirmation Panel -->
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ContractList.IsConfirmingDeleteExtension}" VerticalAlignment="Center">
                            <TextBlock Text="¿Eliminar prórroga?" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource DangerBrush}" FontWeight="Medium" Margin="0 0 8 0" />
                            <Button Content="Sí" Command="{Binding ContractList.ConfirmDeleteExtensionCommand}" Classes="Primary" Background="{DynamicResource DangerBrush}" Padding="8 4" FontSize="11" />
                            <Button Content="No" Command="{Binding ContractList.CancelDeleteExtensionCommand}" Classes="Action" Padding="8 4" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <Border DockPanel.Dock="Top" IsVisible="{Binding ContractList.IsEditingExtension}" Padding="16" Background="{DynamicResource PeriodEditBackgroundBrush}" CornerRadius="8" Margin="0 0 0 16">
                        <StackPanel Spacing="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource FilePathLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ContractList.ExtensionEditFilePath}" IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="..." Click="BrowseExtensionFile_Click" Margin="8 0 0 0" Classes="Action" />
                                </Grid>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource StartDateLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <DatePicker SelectedDate="{Binding ContractList.ExtensionEditStartDate}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource EndDateOptionalLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <DatePicker SelectedDate="{Binding ContractList.ExtensionEditEndDate}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel>
                                    <TextBlock Text="Alquiler" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <NumericUpDown Value="{Binding ContractList.ExtensionEditMonthlyRent}" Minimum="0" FormatString="0.00" Width="100" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Gastos" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <ComboBox ItemsSource="{Binding ContractList.AvailableExpenseTypes}" SelectedItem="{Binding ContractList.ExtensionEditExpensePaymentType}" Width="110" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding ContractList.ExtensionEditExpensePaymentType, Converter={StaticResource EqualityConverter}, ConverterParameter=Fixed}">
                                    <TextBlock Text="Fijo" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <NumericUpDown Value="{Binding ContractList.ExtensionEditFixedExpenseAmount}" Minimum="0" FormatString="0.00" Width="90" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource NotesOptionalLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding ContractList.ExtensionEditNotes}" AcceptsReturn="True" Height="60" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource CancelButton}" Command="{Binding ContractList.CancelExtensionCommand}" Classes="Action" />
                                <Button Content="{DynamicResource SaveButton}" Command="{Binding ContractList.SaveExtensionCommand}" Classes="Primary" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ListBox Classes="Table" ItemsSource="{Binding ContractList.Extensions}" SelectedItem="{Binding ContractList.SelectedExtension}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding FilePath}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource FromLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding StartDate, StringFormat='{}{0:d}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource ToLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding EndDate, StringFormat='{}{0:d}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        </DockPanel>

        <!-- Confirmation Overlay -->
        <Border Background="#A0000000" IsVisible="{Binding ContractList.IsConfirmingDeleteContract}">
            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="320"
                    Height="160"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20">
                <StackPanel Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="¿Confirmar eliminación?" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="Esta acción no se puede deshacer." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Content="Confirmar" Command="{Binding ContractList.ConfirmDeleteContractCommand}" Classes="Primary" Background="{DynamicResource DangerBrush}" />
                        <Button Content="Cancelar" Command="{Binding ContractList.CancelDeleteContractCommand}" Classes="Action" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
