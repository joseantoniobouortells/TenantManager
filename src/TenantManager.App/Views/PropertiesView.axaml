<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TenantManager.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TenantManager.App.Views.PropertiesView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False">

    <Grid>
        <Grid IsEnabled="{Binding !PropertyList.IsConfirmingDeleteProperty}" ColumnDefinitions="*, Auto" Margin="24">
        <!-- LIST SECTION -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 16">
                <TextBlock Grid.Column="0" Text="Viviendas" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Nueva Vivienda" Command="{Binding PropertyList.NewPropertyCommand}" Classes="Primary" />
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource TableBorderBrush}">
                <Grid RowDefinitions="Auto,*">
                     <Grid Grid.Row="0" ColumnDefinitions="2*,1.8*,1*,0.8*,1.2*,Auto" Margin="16 12">
                         <TextBlock Grid.Column="0" Text="Nombre" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                         <TextBlock Grid.Column="1" Text="Calle" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                         <TextBlock Grid.Column="2" Text="Localidad" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                         <TextBlock Grid.Column="3" Text="C.P." FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                         <TextBlock Grid.Column="4" Text="Estado" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                         <TextBlock Grid.Column="5" Text="" Width="40" />
                     </Grid>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding PropertyList.Properties}" SelectedItem="{Binding PropertyList.SelectedProperty}" Classes="Table">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                 <Grid ColumnDefinitions="2*,1.8*,1*,0.8*,1.2*,Auto">
                                     <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                     <TextBlock Grid.Column="1" Text="{Binding Address}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                     <TextBlock Grid.Column="2" Text="{Binding City}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                     <TextBlock Grid.Column="3" Text="{Binding PostalCode}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                     <ToggleSwitch Grid.Column="4" 
                                                   IsChecked="{Binding IsActive, Mode=OneWay}" 
                                                   Command="{Binding $parent[UserControl].DataContext.PropertyList.TogglePropertyActiveCommand}" 
                                                   CommandParameter="{Binding}"
                                                   OnContent="" OffContent="" 
                                                   Margin="0" Padding="0"
                                                   MinWidth="0" MinHeight="0"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                     <Button Grid.Column="5" 
                                             Command="{Binding $parent[UserControl].DataContext.PropertyList.DeletePropertyCommand}" 
                                             CommandParameter="{Binding}"
                                             Classes="Action" Padding="4" Margin="4 0 0 0" ToolTip.Tip="{DynamicResource DeleteButton}" Cursor="Hand">
                                         <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" />
                                     </Button>
                                 </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- EDIT/DETAILS SECTION -->
        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="24"
                IsVisible="{Binding PropertyList.IsEditing}" BorderThickness="1" BorderBrush="{DynamicResource TableBorderBrush}"
                Width="380" Margin="24 0 0 0">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="Detalles de Vivienda" FontSize="18" FontWeight="SemiBold" Margin="0 0 0 24" Foreground="{DynamicResource TextPrimaryBrush}" />

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Nombre" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding PropertyList.EditName}" PlaceholderText="P. ej. Piso Centro" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Calle / Dirección" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding PropertyList.EditAddress}" PlaceholderText="P. ej. Calle Mayor 12, 3ºA" />
                        </StackPanel>
                        
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="8" Margin="0 0 8 0">
                                <TextBlock Text="Localidad" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding PropertyList.EditCity}" PlaceholderText="Madrid" />
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Spacing="8" Margin="8 0 0 0">
                                <TextBlock Text="Código Postal" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding PropertyList.EditPostalCode}" PlaceholderText="28001" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Notas Adicionales" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding PropertyList.EditNotes}" AcceptsReturn="True" Height="100" PlaceholderText="Información de interés, etc." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0 24 0 0">
                    <Button Content="Cancelar" Command="{Binding PropertyList.CancelEditCommand}" />
                    <Button Content="Guardar" Command="{Binding PropertyList.SavePropertyCommand}" Classes="Primary" />
                </StackPanel>
            </Grid>
        </Border>
        </Grid>

        <!-- Confirmation Overlay -->
        <Border Background="#A0000000" IsVisible="{Binding PropertyList.IsConfirmingDeleteProperty}">
            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="320"
                    Height="160"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20">
                <StackPanel Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="¿Confirmar eliminación?" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="Esta acción no se puede deshacer." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Content="Confirmar" Command="{Binding PropertyList.ConfirmDeletePropertyCommand}" Classes="Primary" Background="{DynamicResource DangerBrush}" />
                        <Button Content="Cancelar" Command="{Binding PropertyList.CancelDeletePropertyCommand}" Classes="Action" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
