<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TenantManager.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TenantManager.App.Views.ExpensesView"
             x:CompileBindings="False">
    <Grid>
        <DockPanel IsEnabled="{Binding !ExpenseList.IsConfirmingDeleteInvoice}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0 0 0 24">
            <TextBlock Grid.Column="0" Classes="H1" Text="{DynamicResource ExpensesTitle}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <TextBox Text="{Binding ExpenseList.SearchQuery}" PlaceholderText="Buscar gasto..." Width="200" VerticalAlignment="Center" />
                <Button Command="{Binding ExpenseList.NewInvoiceCommand}" Classes="Primary" Padding="8" ToolTip.Tip="{DynamicResource NewExpenseButton}" Cursor="Hand">
                    <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="16" Height="16" Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Classes="Card" IsVisible="{Binding ExpenseList.IsEditing}">
            <StackPanel Spacing="16">
                <TextBlock Classes="H2" Text="Edit Invoice" Margin="0" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0">
                    <!-- Column 0 -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0 0 8 12">
                        <TextBlock Text="Expense Type" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding ExpenseList.EditExpenseType}" />
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0 0 8 12" Orientation="Horizontal" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource YearLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <NumericUpDown Value="{Binding ExpenseList.EditYear}" Minimum="2000" Maximum="2100" FormatString="0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MonthLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <NumericUpDown Value="{Binding ExpenseList.EditMonth}" Minimum="1" Maximum="12" FormatString="0" />
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Column 1 -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="8 0 0 12">
                        <TextBlock Text="Amount" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                        <NumericUpDown Value="{Binding ExpenseList.EditAmount}" Minimum="0" FormatString="0.00" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="8 0 0 12">
                        <TextBlock Text="Factura PDF" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" Text="{Binding ExpenseList.EditFilePath}" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="..." Click="BrowseFile_Click" Margin="8 0 0 0" Classes="Action" />
                            <Button Grid.Column="2" Content="X" Command="{Binding ExpenseList.ClearFileCommand}" Margin="4 0 0 0" Classes="Action" Foreground="{DynamicResource DangerBrush}" ToolTip.Tip="Clear File" />
                        </Grid>
                    </StackPanel>
                </Grid>
                <StackPanel>
                    <TextBlock Text="{DynamicResource NotesOptionalLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                    <TextBox Text="{Binding ExpenseList.EditNotes}" AcceptsReturn="True" Height="60" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource IsChargeableLabel}" VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding ExpenseList.EditIsChargeableToTenant}" OnContent="{DynamicResource YesLabel}" OffContent="{DynamicResource NoLabel}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource CancelButton}" Command="{Binding ExpenseList.CancelEditCommand}" Classes="Action" />
                    <Button Content="Delete Invoice" Command="{Binding ExpenseList.DeleteInvoiceCommand}" Classes="Action" Foreground="{DynamicResource DangerBrush}" />
                    <Button Content="Save Invoice" Command="{Binding ExpenseList.SaveInvoiceCommand}" Classes="Primary" />
                </StackPanel>
            </StackPanel>
        </Border>



         <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,1*,1*,1.5*,1*,1*,Auto" Margin="16 0 16 8">
             <Button Grid.Column="0" Command="{Binding ExpenseList.SortCommand}" CommandParameter="ExpenseType" 
                     Background="Transparent" BorderThickness="0" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand">
                 <StackPanel Orientation="Horizontal" Spacing="4">
                     <TextBlock Text="Type" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                     <TextBlock Text="{Binding ExpenseList.TypeSortIndicator}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                 </StackPanel>
             </Button>
             <Button Grid.Column="1" Command="{Binding ExpenseList.SortCommand}" CommandParameter="Year" 
                     Background="Transparent" BorderThickness="0" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand">
                 <StackPanel Orientation="Horizontal" Spacing="4">
                     <TextBlock Text="{DynamicResource YearLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                     <TextBlock Text="{Binding ExpenseList.YearSortIndicator}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                 </StackPanel>
             </Button>
             <Button Grid.Column="2" Command="{Binding ExpenseList.SortCommand}" CommandParameter="Month" 
                     Background="Transparent" BorderThickness="0" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand">
                 <StackPanel Orientation="Horizontal" Spacing="4">
                     <TextBlock Text="{DynamicResource MonthLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                     <TextBlock Text="{Binding ExpenseList.MonthSortIndicator}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                 </StackPanel>
             </Button>
             <Button Grid.Column="3" Command="{Binding ExpenseList.SortCommand}" CommandParameter="Amount" 
                     Background="Transparent" BorderThickness="0" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand">
                 <StackPanel Orientation="Horizontal" Spacing="4">
                     <TextBlock Text="Amount" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                     <TextBlock Text="{Binding ExpenseList.AmountSortIndicator}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                 </StackPanel>
             </Button>
             <Button Grid.Column="4" Command="{Binding ExpenseList.SortCommand}" CommandParameter="IsChargeableToTenant" 
                     Background="Transparent" BorderThickness="0" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand">
                 <StackPanel Orientation="Horizontal" Spacing="4">
                     <TextBlock Text="{DynamicResource ChargeableColumnHeader}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                     <TextBlock Text="{Binding ExpenseList.ChargeableSortIndicator}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                 </StackPanel>
             </Button>
             <TextBlock Grid.Column="5" Text="Factura PDF" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" VerticalAlignment="Center" />
             <TextBlock Grid.Column="6" Text="" Width="40" />
         </Grid>

        <ListBox Classes="Table" ItemsSource="{Binding ExpenseList.Invoices}" SelectedItem="{Binding ExpenseList.SelectedInvoice}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                     <Grid ColumnDefinitions="2*,1*,1*,1.5*,1*,1*,Auto">
                         <TextBlock Grid.Column="0" Text="{Binding ExpenseType}" FontWeight="Medium" VerticalAlignment="Center" />
                         <TextBlock Grid.Column="1" Text="{Binding Year}" VerticalAlignment="Center" />
                         <TextBlock Grid.Column="2" Text="{Binding Month}" VerticalAlignment="Center" />
                         <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" />
                         <TextBlock Grid.Column="4" Text="{DynamicResource YesLabel}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding IsChargeableToTenant}" />
                         <TextBlock Grid.Column="4" Text="{DynamicResource NoLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsChargeableToTenant}" />
                         <Button Grid.Column="5" 
                                 Command="{Binding $parent[UserControl].DataContext.ExpenseList.OpenFileCommand}" 
                                 CommandParameter="{Binding}"
                                 IsEnabled="{Binding HasFile}"
                                 Classes="Action" Padding="4" ToolTip.Tip="{DynamicResource ViewPdfButton}" Cursor="Hand">
                             <PathIcon Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zM6 20V4h7v5h5v11H6zM8 16h8v2H8v-2zm0-4h8v2H8v-2z" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                         </Button>
                         <Button Grid.Column="6" 
                                 Command="{Binding $parent[UserControl].DataContext.ExpenseList.DeleteInvoiceCommand}" 
                                 CommandParameter="{Binding}"
                                 Classes="Action" Padding="4" Margin="4 0 0 0" ToolTip.Tip="{DynamicResource DeleteButton}" Cursor="Hand">
                             <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" />
                         </Button>
                     </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </DockPanel>

        <!-- Confirmation Overlay -->
        <Border Background="#A0000000" IsVisible="{Binding ExpenseList.IsConfirmingDeleteInvoice}">
            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="320"
                    Height="160"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20">
                <StackPanel Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="¿Confirmar eliminación?" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="Esta acción no se puede deshacer." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Content="Confirmar" Command="{Binding ExpenseList.ConfirmDeleteInvoiceCommand}" Classes="Primary" Background="{DynamicResource DangerBrush}" />
                        <Button Content="Cancelar" Command="{Binding ExpenseList.CancelDeleteInvoiceCommand}" Classes="Action" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
