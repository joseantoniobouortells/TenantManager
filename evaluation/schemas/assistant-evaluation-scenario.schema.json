{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Assistant Evaluation Scenario",
  "type": "object",
  "required": [
    "id",
    "language",
    "messages"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the scenario."
    },
    "language": {
      "type": "string",
      "enum": ["es", "en"],
      "description": "Language of the scenario."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of what this scenario evaluates."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "referenceDate": {
      "type": "string",
      "format": "date",
      "description": "Fixed date against which relative temporal expressions are evaluated."
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "expected"],
        "properties": {
          "text": { "type": "string" },
          "expected": {
            "type": "object",
            "properties": {
              "intent": { "type": "string", "enum": ["data_query", "previous_result_query", "unknown"] },
              "resource": { "type": "string" },
              "operation": { "type": "string" },
              "projection": { "type": "array", "items": { "type": "string" } },
              "requestedOutputs": { "type": "array", "items": { "type": "string" } },
              "resolvedYear": { "type": "integer" },
              "resolvedMonth": { "type": "integer" },
              "resolvedStartDate": { "type": "string", "format": "date" },
              "resolvedEndDate": { "type": "string", "format": "date" },
              "queryExecution": { "type": "string", "enum": ["required", "forbidden", "optional"] },
              "answerContains": { "type": "array", "items": { "type": "string" } },
              "answerNotContains": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
